public static ArrayList<LayerCodeSave> parsingLyp(InputStream is) throws Exception {

    ArrayList<LayerCodeSave> layerList = new ArrayList<>();

    // XML 파서 생성
    DocumentBuilderFactory dbFactory = DocumentBuilderFactory.newInstance();
    DocumentBuilder dBuilder = dbFactory.newDocumentBuilder();

    Document doc = dBuilder.parse(is);
    doc.getDocumentElement().normalize();

    // 모든 <properties> 요소 가져오기
    NodeList nList = doc.getElementsByTagName("properties");

    // 각 <properties> 요소 반복 처리
    for (int i = 0; i < nList.getLength(); i++) {

        Node nNode = nList.item(i);

        if (nNode.getNodeType() != Node.ELEMENT_NODE) {
            continue;
        }

        Element elem = (Element) nNode;

        String lyr_cd;
        String lyr_cd_nm;
        int srt_sqn;

        // name 태그 확인
        NodeList nameNodeList = elem.getElementsByTagName("name");

        if (nameNodeList.getLength() == 0) {
            continue;
        }

        String name = nameNodeList.item(0)
                .getTextContent()
                .trim();


        /*
         * ============================================================
         * 기존 LYP 형식
         *
         * 예)
         *
         * <name>PWELL.drawing - 1/0</name>
         *
         * 또는
         *
         * <name>METAL.pin - 10/5</name>
         *
         * ============================================================
         */
        if (name.contains(" - ")) {

            String[] nameParts = name.split("\\s+-\\s+", 2);

            // 예상하지 못한 데이터는 건너뜀
            if (nameParts.length < 2) {
                continue;
            }

            /*
             * PWELL.drawing
             *
             * prefixs[0] = PWELL
             * prefixs[1] = drawing
             */
            String[] prefixs = nameParts[0].split("\\.", 2);

            lyr_cd_nm = prefixs[0];

            /*
             * 1/0
             * 10/5
             */
            String source = nameParts[1].trim();

            /*
             * 혹시 기존 파일에도
             *
             * 1/0@1
             *
             * 같은 값이 들어오는 경우를 대비해서
             * @ 뒤는 제거
             */
            int atIndex = source.indexOf("@");

            if (atIndex >= 0) {
                source = source.substring(0, atIndex);
            }

            String[] sourceParts = source.split("/", 2);

            int layer = Integer.parseInt(sourceParts[0].trim());

            int datatype = 0;

            if (sourceParts.length > 1
                    && !sourceParts[1].trim().isEmpty()) {

                datatype = Integer.parseInt(
                        sourceParts[1].trim()
                );
            }

            /*
             * layer code
             *
             * 1/0  -> 1
             * 10/5 -> 10_5
             */
            lyr_cd = String.valueOf(layer);

            if (datatype != 0) {

                lyr_cd += "_" + datatype;

                /*
                 * 기존 로직 유지
                 *
                 * datatype != 0 이고
                 * PWELL.drawing 처럼 "." 뒤 값이 존재할 경우
                 *
                 * layerName = PWELL.drawing
                 */
                if (prefixs.length > 1) {
                    lyr_cd_nm += "." + prefixs[1];
                }
            }

            /*
             * 정렬 순서
             *
             * 1/0  -> 1000
             * 10/5 -> 10005
             */
            srt_sqn = layer * 1000 + datatype;


        /*
         * ============================================================
         * 새로운 LYP 형식
         *
         * 예)
         *
         * <name>1/0@PGAN</name>
         * <source>1/0@1</source>
         *
         * <name>10/5@M1</name>
         * <source>10/5@1</source>
         *
         * ============================================================
         */
        } else if (name.contains("@")) {

            /*
             * name
             *
             * 1/0@PGAN
             *
             * nameParts[0] = 1/0
             * nameParts[1] = PGAN
             */
            String[] nameParts = name.split("@", 2);

            if (nameParts.length < 2) {
                continue;
            }

            lyr_cd_nm = nameParts[1].trim();


            /*
             * source 태그를 우선 사용
             *
             * <source>1/0@1</source>
             */
            String source;

            NodeList sourceNodeList =
                    elem.getElementsByTagName("source");

            if (sourceNodeList.getLength() > 0) {

                source = sourceNodeList.item(0)
                        .getTextContent()
                        .trim();

            } else {

                /*
                 * source 태그가 없는 경우
                 *
                 * name의 @ 앞부분 사용
                 *
                 * 1/0@PGAN
                 * -> 1/0
                 */
                source = nameParts[0].trim();
            }


            /*
             * source가
             *
             * 1/0@1
             *
             * 형태라면 @ 뒤 제거
             */
            int sourceAtIndex = source.indexOf("@");

            if (sourceAtIndex >= 0) {
                source = source.substring(
                        0,
                        sourceAtIndex
                );
            }


            /*
             * 1/0
             *
             * sourceParts[0] = 1
             * sourceParts[1] = 0
             */
            String[] sourceParts =
                    source.split("/", 2);

            int layer =
                    Integer.parseInt(
                            sourceParts[0].trim()
                    );

            int datatype = 0;

            if (sourceParts.length > 1
                    && !sourceParts[1].trim().isEmpty()) {

                datatype =
                        Integer.parseInt(
                                sourceParts[1].trim()
                        );
            }


            /*
             * Layer Code
             *
             * 1/0  -> 1
             * 10/5 -> 10_5
             */
            lyr_cd = String.valueOf(layer);

            if (datatype != 0) {
                lyr_cd += "_" + datatype;
            }


            /*
             * 정렬 순서
             */
            srt_sqn = layer * 1000 + datatype;


        } else {

            /*
             * 현재 알고 있는 두 형식이 아닌 경우
             * 에러를 발생시키지 않고 건너뜀
             */
            continue;
        }


        /*
         * ============================================================
         * 결과 저장
         * ============================================================
         */

        LayerCodeSave layerMap =
                new LayerCodeSave();

        layerMap.setLayerCode(lyr_cd);
        layerMap.setLayerName(lyr_cd_nm);
        layerMap.setSortSequence(srt_sqn);

        layerList.add(layerMap);
    }

    return layerList;
}