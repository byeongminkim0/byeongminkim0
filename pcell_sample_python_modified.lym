 <text>import pya
import math
from collections import deque
from utils.expression_utils import CoordinateUtils
from constants import SHAPE_ID_CODE
import logging

logger = logging.getLogger(__name__)

class Module(pya.PCellDeclarationHelper):
  def __init__(self):

    # Important: initialize the super class
    super(Module, self).__init__()
    self.using_layer_list = []
    # PCell 선언 객체는 register_pcell 로 라이브러리당 1개만 등록되어 모든
    # variant 가 공유한다. pick up 좌표 보정에 쓰는 직전 값은 cell 단위로
    # 보관해야 모듈 드로잉에서 DUT 끼리 값이 섞이지 않는다.
    self._pickup_prev_state = {}
    # ******************** 기본적으로 사용되는 layer ********************
    #self.param('l9', self.TypeLayer, 'CONT', default = pya.LayerInfo(9,0), hidden = True)
    #self.param('l11', self.TypeLayer, 'VIA1', default = pya.LayerInfo(11,0), hidden = True)
    #self.param('l13', self.TypeLayer, 'VIA2', default = pya.LayerInfo(13,0), hidden = True)
    #self.param('l15', self.TypeLayer, 'VIA3', default = pya.LayerInfo(15,0), hidden = True)
    # ******************** 1. 사용 중인 레이어 선언 ********************
    self.param('l1', self.TypeLayer, 'PGAN', default = pya.LayerInfo(1,0), hidden = True)
    self.param('l2', self.TypeLayer, 'ISO', default = pya.LayerInfo(2,0), hidden = True)
    self.param('l5', self.TypeLayer, 'GATE_CONT', default = pya.LayerInfo(5,0), hidden = True)
    self.param('l6', self.TypeLayer, 'GATE_METAL', default = pya.LayerInfo(6,0), hidden = True)
    self.param('l7', self.TypeLayer, 'FP', default = pya.LayerInfo(7,0), hidden = True)
    self.param('l9', self.TypeLayer, 'M1C', default = pya.LayerInfo(9,0), hidden = True)
    self.param('l10', self.TypeLayer, 'M1', default = pya.LayerInfo(10,0), hidden = True)
    self.param('l11', self.TypeLayer, 'M2C', default = pya.LayerInfo(11,0), hidden = True)
    self.param('l12', self.TypeLayer, 'M2', default = pya.LayerInfo(12,0), hidden = True)
    self.param('l21', self.TypeLayer, 'TV', default = pya.LayerInfo(21,0), hidden = True)
    self.param('l23', self.TypeLayer, 'OHMIC_CONT', default = pya.LayerInfo(23,0), hidden = True)
    self.param('l24', self.TypeLayer, 'OHMIC_METAL', default = pya.LayerInfo(24,0), hidden = True)
    self.param('l25', self.TypeLayer, 'PIQ', default = pya.LayerInfo(25,0), hidden = True)
    self.param('l63', self.TypeLayer, 'BOUNDARY', default = pya.LayerInfo(63,0), hidden = True)
    self.param('l4', self.TypeLayer, 'DGATE_CONT', default = pya.LayerInfo(4,0), hidden = True)
    self.param('l-1_-1', self.TypeLayer, 'L-1.-1', default = pya.LayerInfo(-1,-1), hidden = True)
    self.using_layer_list = ['9', '11', '7', '6', '5', '2', '1', '10', '23', '24', '12', '25', '21', '63', '-1']    

    logger.debug(self.using_layer_list)
    # ******************** diff_c의 p1 좌표가 되는 기준좌표 ********************
    self.param("x", self.TypeDouble, "", default = 0, hidden = True)
    self.param("y", self.TypeDouble, "", default = 0, hidden = True)
    self.param("dut_id", self.TypeDouble, "", default = 0, hidden = True)
    
    # ******************** 위저드 설정 값 ********************
    self.param('cell_nm', self.TypeString, 'cell_nm', default = '', hidden = True)


    # ******************** 2. 유저 파라미터 선언 ********************
    self.param('M1_34_W', self.TypeDouble, 'A', default = 1162, hidden = False)
    self.param('n', self.TypeDouble, 'x', default = 120, hidden = False)
    self.param('psub_row', self.TypeInt, 'PSUB Row', default = 1, hidden = False)
    self.param('psub_col', self.TypeInt, 'PSUB Col', default = 1, hidden = False)
    self.param('iso_row', self.TypeInt, 'ISO Row', default = 1, hidden = False)
    self.param('iso_col', self.TypeInt, 'ISO Col', default = 1, hidden = False)
    self.param('isub_row', self.TypeInt, 'ISUB Row', default = 1, hidden = False)
    self.param('isub_col', self.TypeInt, 'ISUB Col', default = 1, hidden = False)
    self.param('Cont_w', self.TypeDouble, 'Cont_w', default = 0.6, hidden = False)
    self.param('Cont_h', self.TypeDouble, 'Cont_h', default = 0.6, hidden = False)
    self.param('Via_w', self.TypeDouble, 'Via_w', default = 1.0, hidden = False)
    self.param('Via_h', self.TypeDouble, 'Via_h', default = 1.0, hidden = False)
    self.param('Pimp_w', self.TypeDouble, 'Pimp_w', default = None, hidden = False)
    self.param('Pimp_h', self.TypeDouble, 'Pimp_h', default = None, hidden = False)
    self.param('Nimp_w', self.TypeDouble, 'Nimp_w', default = None, hidden = False)
    self.param('Nimp_h', self.TypeDouble, 'Nimp_h', default = None, hidden = False)
    self.param('dvc_type', self.TypeString, 'dvc_type', default = 'G', hidden = True)
    self.param('m', self.TypeInt, 'm', default = 0, hidden = True)    

    
  def display_text_impl(self):
    return "Module"
    
  def set_pick_up_parameter(self, width, pitch, margin, hole_size, hole_x1=None, hole_x2=None, hole_y1=None, hole_count=None):
    self.unit_width = width
    self.pick_up_pitch = pitch
    self.pick_up_margin = margin
    self.hole_size = hole_size
    self.pick_up_hole_x1 = hole_x1
    self.pick_up_hole_x2 = hole_x2
    self.pick_up_hole_y1 = hole_y1
    self.pick_up_count = hole_count

  def coerce_parameters_impl(self):
    # Cont, Via의 크기
    # self.Cont_w = 0.16
    # self.Via_w = 0.19
    
    # Finger가 없을경우 15 설정
    if not hasattr(self, 'n'):
        self.n = 1
    # Finger가 2개보다 작을경우 2로 고정
    if self.n &lt; 2:
        self.n = 1
    # Floor
    if not hasattr(self, 'o'):
        self.o = 1
    if self.o &lt; 2:
        self.o = 1
        
    if not hasattr(self, 'width_multiple'):
        self.width_multiple = 1
        
    if self.width_multiple &lt; 1:
        self.width_multiple = 1

    if not hasattr(self, 'psub_row'):
        self.psub_row = 1
    if not hasattr(self, 'psub_col'):
        self.psub_col = 1
    self.psub_row = max(1, int(self.psub_row))
    self.psub_col = max(1, int(self.psub_col))
    if not hasattr(self, 'iso_row'):
        self.iso_row = 1
    if not hasattr(self, 'iso_col'):
        self.iso_col = 1
    self.iso_row = max(1, int(self.iso_row))
    self.iso_col = max(1, int(self.iso_col))
    if not hasattr(self, 'isub_row'):
        self.isub_row = 1
    if not hasattr(self, 'isub_col'):
        self.isub_col = 1
    self.isub_row = max(1, int(self.isub_row))
    self.isub_col = max(1, int(self.isub_col))

    # Pick_Up Parameter 처리


    # ******************* 수식으로 되어있는 심벌에 대한 처리 ******************

    if not hasattr(self, 'diode_met2s'):
        self.diode_met2s = []
    if not hasattr(self, 'diode_met2_cnt'):
        self.diode_met2_cnt = 0
    if not hasattr(self, 'diode_met2_dict'):
        self.diode_met2_dict = {}
    
    #self.process_diode_met2()
    #self.diode_met2s = []
    #self.diode_met2_dict = {}
  
  # Cont, Via의 row, col 갯수를 구하는 함수
  def get_cnt(self, area, w, pitch):
      if w + pitch == 0:
          return 0
      cnt = area//(w + pitch)
      if round(area%(w+pitch), 10) &gt;= w:
          cnt = cnt + 1
      if cnt &lt; 0:
          cnt = 0
      return cnt

  def get_intersection_rect(self, box1, box2):
    x1_1 = box1.p1.x
    y1_1 = box1.p1.y
    x2_1 = box1.p2.x
    y2_1 = box1.p2.y

    x1_2 = box2.p1.x
    y1_2 = box2.p1.y
    x2_2 = box2.p2.x
    y2_2 = box2.p2.y

    # 교차 부분의 좌표를 계산
    inter_x1 = max(x1_1, x1_2)
    inter_y1 = max(y1_1, y1_2)
    inter_x2 = min(x2_1, x2_2)
    inter_y2 = min(y2_1, y2_2)

    # 교차하는 부분이 유효한지 확인
    if inter_x1 &lt; inter_x2 and inter_y1 &lt; inter_y2:
        return pya.DBox(inter_x1, inter_y1, inter_x2, inter_y2)
    else:
        return None

  def can_create_from_shape_impl(self):
    return self.shape.is_box() or self.shape.is_polygon() or self.shape.is_path()
  
  def transformation_from_shape_impl(self):
    return pya.Trans(self.shape.bbox().center())
  
  def produce_impl(self):
    # ******************** Unit Cell 그리기 ********************
    # 전체 Module 안에 세부 UnitCell, Cont, Via 를 구분
    unitCell = self.layout.create_cell(self.cell_nm+"_unitCell")
    ringCell = self.layout.create_cell(self.cell_nm+"_ringCell")
    psubCell = self.layout.create_cell(self.cell_nm+"_psubCell")
    isoCell = self.layout.create_cell(self.cell_nm+"_isoCell")
    isubCell = self.layout.create_cell(self.cell_nm+"_isubCell")

    cell = self.cell
    
    # *********************** Cont Via Cell 생성 ****************************
    if self.layout.cell('CONT_Ref') is None:
      self.contCell = self.layout.create_cell('CONT_Ref')
      self.contCell.shapes(self.l9_layer).insert(pya.DBox(0,0,self.Cont_w,self.Cont_h))
    else:
      self.contCell = self.layout.cell('CONT_Ref')

    if self.layout.cell('VIA12_Ref') is None:
