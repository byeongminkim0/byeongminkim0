  def process_diode_met2(self):
    is_count_zero = self.diode_met2_cnt == 0
    is_count_odd = self.diode_met2_cnt % 2 == 1
    if is_count_zero or is_count_odd:
        return
    logger.debug(self.diode_met2s)
    logger.debug(self.diode_met2_dict)

    for shape_info in self.diode_met2s:
        shape_id = shape_info[0]
        shape = shape_info[1]
        if shape.is_box() and shape.box_height &gt; 10.4:
            logger.debug('resize met2')
            shape.delete()
    
  def process_diode_met2_back(self):
    is_count_zero = self.diode_met2_cnt == 0
    is_count_odd = self.diode_met2_cnt % 2 == 1
    if is_count_zero or is_count_odd:
        return

    lst = sorted(self.diode_met2s, key=lambda x: x[0])
    total_cnt = len(self.diode_met2s)
    pop_cnt = self.diode_met2_cnt
    logger.debug(lst)
    logger.debug(total_cnt)
    logger.debug(pop_cnt)
    
    start = (total_cnt // 2) - (pop_cnt // 2)
    end = (total_cnt // 2) + (pop_cnt // 2)
    targets = lst[start:end]
    
    for target in targets:
        logger.debug(target)
        target[1].delete()
        
  def corner_radius(self, depth, segments):
    # n 분할 접선 다각형에서 depth = R * (1 - tan(pi/n)) 이므로 그 역.
    # segments=8 이 기존 45도 chamfer 와 정확히 같다.
    if not depth or segments is None or segments &lt;= 4:
        return 0.0
    denominator = 1.0 - math.tan(math.pi / float(segments))
    if denominator &lt;= 1e-9:
        return 0.0
    return float(depth) / denominator

  def contour_polygon(self, contour, box):
    # Exact sampled vertices; edge offsets remain fixed when expressions resize.
    xs = [box.left, box.right]
    ys = [box.bottom, box.top]
    min_width = max((p[1] for p in contour if p[0] == 0), default=0) - min((p[1] for p in contour if p[0] == 1), default=0)
    min_height = max((p[3] for p in contour if p[2] == 0), default=0) - min((p[3] for p in contour if p[2] == 1), default=0)
    if box.width() + 1e-10 &lt; min_width or box.height() + 1e-10 &lt; min_height:
        raise ValueError("Shape dimensions are too small to preserve its contour")
    return pya.DPolygon([pya.DPoint(xs[sx] + dx, ys[sy] + dy) for sx, dx, sy, dy in contour])

  def round_shape_corners(self, shape, depth, segments, corner_typ, bbox=None):
    if isinstance(depth, dict):
        contour = depth['contour'].get('hull')
        if contour:
            target = bbox if bbox is not None else shape.dpolygon.bbox()
            shape.dpolygon = self.contour_polygon(contour, target)
            return
        depth = depth['depth']
    # corner_typ: '00'  각짐 / '01' chamfer / '02' 라운드 / '03' 원(타원)
    if corner_typ == '03':
        target = bbox if bbox is not None else shape.dpolygon.bbox()
        n = int(segments) if segments and int(segments) &gt;= 8 else 8
        shape.dpolygon = pya.DPolygon.ellipse(target, n)
        return
    if not depth or float(depth) == 0.0:
        return
    n = int(segments) if segments and int(segments) &gt; 4 else 8
    shape.dpolygon = shape.dpolygon.round_corners(0.0, self.corner_radius(depth, n), n)

  def insert_box(self, shape_id, cell, layer, p1, p2, corner, corner_seg=8, corner_typ='01', t=None, ref=None):
    box = pya.DBox(p1[0], p1[1], p2[0],p2[1])
    shape = cell.shapes(layer).insert(box)
    shape.set_property(SHAPE_ID_CODE, str(shape_id))
    if self.dvc_type == 'D' and hasattr(self, 'l12_layer') and layer == self.l12_layer and cell.bbox().width() &gt; cell.bbox().height():
        self.diode_met2s.append((round(p1[0], 10), shape))
        if p2[0] - p1[0] &lt; 4.2:
            shape.delete()
            self.diode_met2_cnt += 1
    if self.dvc_type == 'D' and hasattr(self, 'l12_layer') and layer == self.l12_layer and cell.bbox().width() &lt; cell.bbox().height():
        if p1[1] &gt; cell.bbox().p1.y/1000 and p2[1] &lt; cell.bbox().p2.y/1000:
            self.diode_met2s.append((shape_id, shape))
            self.diode_met2_cnt += 1
    self.round_shape_corners(shape, corner, corner_seg, corner_typ, box)
    return box

  def insert_text(self, shape_id, cell, layer, p1, t, value):
    text = pya.DText(value, p1[0], p1[1])
    shape = cell.shapes(layer).insert(text)
    shape.set_property(SHAPE_ID_CODE, str(shape_id))
    return text
    
  def hole_corner_spec(self, hole):
    # {corner, x1, y1, x2, y2, corner_seg, corner_typ} 7원소.
    # 컬럼 추가 이전 데이터는 5원소이므로 n=8('01')로 폴백한다.
    depth = float(hole[0]) if hole[0] not in (None, '') else 0.0
    segments = 8
    if len(hole) &gt; 5 and hole[5] not in (None, ''):
        segments = int(float(hole[5]))
    corner_typ = '01'
    if len(hole) &gt; 6 and hole[6] not in (None, ''):
        corner_typ = str(hole[6]).strip()
    return depth, segments, corner_typ

  def insert_polygon(self, shape_id, cell, layer, hull_x1, hull_x2, hull_y1, hull_y2, hole_list, corner, corner_seg=8, corner_typ='01', t=None):
    # hull 과 hole 의 분할 수가 다를 수 있어 각각 라운드한 뒤 Region 차집합으로
    # 합친다. (round_corners 는 hull/hole 에 같은 n 을 강제한다)
    contour_data = corner.get('contour', {}) if isinstance(corner, dict) else {}
    corner = corner['depth'] if isinstance(corner, dict) else corner
    hull_box = pya.DBox(hull_x1, hull_y1, hull_x2, hull_y2)
    if contour_data.get('hull'):
        hull_polygon = self.contour_polygon(contour_data['hull'], hull_box)
    elif corner_typ == '03':
        hull_polygon = pya.DPolygon.ellipse(hull_box, int(corner_seg) if corner_seg else 8)
    else:
        hull_polygon = pya.DPolygon(hull_box)
        if corner and float(corner) != 0.0:
            n = int(corner_seg) if corner_seg and int(corner_seg) &gt; 4 else 8
            hull_polygon = hull_polygon.round_corners(0.0, self.corner_radius(corner, n), n)

    region = pya.Region(hull_polygon.to_itype(self.layout.dbu))
    for hole in hole_list:
        hole_depth, hole_seg, hole_typ = self.hole_corner_spec(hole)
        hole_box = pya.DBox(eval(hole[1]), eval(hole[2]), eval(hole[3]), eval(hole[4]))
        contour = hole[7] if len(hole) &gt; 7 else None
        if contour:
            hole_polygon = self.contour_polygon(contour, hole_box)
        elif hole_typ == '03':
            hole_polygon = pya.DPolygon.ellipse(hole_box, hole_seg if hole_seg &gt;= 8 else 8)
        else:
            hole_polygon = pya.DPolygon(hole_box)
            if hole_depth != 0.0:
                n = hole_seg if hole_seg &gt; 4 else 8
                hole_polygon = hole_polygon.round_corners(0.0, self.corner_radius(hole_depth, n), n)
        region -= pya.Region(hole_polygon.to_itype(self.layout.dbu))
    region.merge()

    polygon = None
    for part in region.each():
        shape = cell.shapes(layer).insert(part)
        shape.set_property(SHAPE_ID_CODE, str(shape_id))
        if polygon is None:
            polygon = part
    return polygon
                
  def shape_bbox_um(self, shape):
    # insert_box 는 DBox(um) 를, insert_polygon 은 정수 Polygon(DBU) 을 돌려준다.
    # 텍스트 앵커처럼 반환값을 좌표로 다시 쓰는 곳은 단위를 맞춰야 한다.
    box = shape.bbox() if hasattr(shape, 'bbox') else shape
    if isinstance(box, pya.Box):
        return box.to_dtype(self.layout.dbu)
    return box

  def primitive_height(self, name, w):
    # 정사각형이 아닌 CONT/VIA(예: GaN ohmic bar)는 세로 계산에 자기 높이를
    # 써야 한다. 높이를 모르면 기존처럼 폭과 같다고 본다.
    h = getattr(self, name, None)
    if h is None or float(h) &lt;= 0:
        return w
    return float(h)

  def insert_via(self, shape_id, cell, ref, margin_l, margin_r, margin_t, margin_b, x_pitch, y_pitch, w, tt, center_shape):
    h = self.primitive_height('Via_h', w)
    row = self.get_cnt(ref.p2.y - margin_t - (ref.p1.y + margin_b), h, y_pitch)
    col = self.get_cnt(ref.p2.x - margin_r - (ref.p1.x + margin_l), w, x_pitch)
    if col &lt; 1 or row &lt; 1:
        logger.warning(
            f"[insert_via] shape_id={shape_id} clamped (margin 초과 가능): "
            f"row={row}, col={col} -&gt; 1x1 로 강제. "
            f"ref=({ref.p1.x},{ref.p1.y})-({ref.p2.x},{ref.p2.y}), "
            f"margin=(l={margin_l}, r={margin_r}, t={margin_t}, b={margin_b}), "
            f"pitch=(x={x_pitch}, y={y_pitch}), w={w}"
        )
    if col &lt; 1:
        col = 1
    if row &lt; 1:
        row = 1

    # 기본은 ref 중앙 정렬이지만, 배열이 margin 유효 영역을 벗어나면
    # sample 위치를 유지하도록 left margin 기준으로 정렬한다.
    array_width = (w * col) + (x_pitch * (col - 1))
    t_x = (ref.p2.x + ref.p1.x)/2 - array_width/2
    valid_x1 = ref.p1.x + margin_l
    valid_x2 = ref.p2.x - margin_r
    if t_x &lt; valid_x1 - 1e-9 or t_x + array_width &gt; valid_x2 + 1e-9:
      t_x = valid_x1
    # y축: top_margin≈bottom_margin 이면 가운데정렬(기존),
    # 비대칭(예: gate cont가 poly 상단)이면 sample 위치 보존 위해 margin-anchored 로 전환.
    if abs(margin_t - margin_b) &lt; 1e-9:
      t_y = (ref.p2.y + ref.p1.y)/2 - ((h * row) + (y_pitch * (row - 1)))/2
    else:
      t_y = ref.p1.y + margin_b

    ttt = pya.CplxTrans((t_x)*1000, (t_y)*1000)
    inst = cell.insert(pya.CellInstArray(self.viaCell, ttt, pya.Vector(CoordinateUtils.remove_small_constants(x_pitch+w)*1000, 0), pya.Vector(0, CoordinateUtils.remove_small_constants(y_pitch+h)*1000), col, row))
    inst.set_property(SHAPE_ID_CODE, str(shape_id))

  def insert_cont(self, shape_id, cell, ref, margin_l, margin_r, margin_t, margin_b, x_pitch, y_pitch, w, tt, center_shape):
    h = self.primitive_height('Cont_h', w)
    row = self.get_cnt(ref.p2.y - margin_t - (ref.p1.y + margin_b), h, y_pitch)
    col = self.get_cnt(ref.p2.x - margin_r - (ref.p1.x + margin_l), w, x_pitch)
    if col &lt; 1 or row &lt; 1:
        logger.warning(
            f"[insert_cont] shape_id={shape_id} clamped (margin 초과 가능): "
            f"row={row}, col={col} -&gt; 1x1 로 강제. "
            f"ref=({ref.p1.x},{ref.p1.y})-({ref.p2.x},{ref.p2.y}), "
            f"margin=(l={margin_l}, r={margin_r}, t={margin_t}, b={margin_b}), "
            f"pitch=(x={x_pitch}, y={y_pitch}), w={w}"
        )
    if col &lt; 1:
        col = 1
    if row &lt; 1:
        row = 1
    center_ref = ref
    if center_shape is not None:
      if hasattr(center_shape, 'p1') and hasattr(center_shape, 'p2'):
        center_ref = center_shape
      elif hasattr(center_shape, 'bbox'):
        center_ref = center_shape.bbox()

    # 기준 rect에서 치우친 CONT는 MET1 중심으로 재정렬한다. 각 축의
    # margin이 같은 경우에는 기존 ref 중심 배치를 유지한다.
    center_on_metal_x = abs(margin_l - margin_r) &gt;= 1e-9
    center_on_metal_y = abs(margin_t - margin_b) &gt;= 1e-9
    array_width = (w * col) + (x_pitch * (col - 1))
    x_center_ref = center_ref if center_on_metal_x else ref
    t_x = (x_center_ref.p2.x + x_center_ref.p1.x)/2 - array_width/2
    valid_x1 = ref.p1.x + margin_l
    valid_x2 = ref.p2.x - margin_r
    if not center_on_metal_x and (
      t_x &lt; valid_x1 - 1e-9 or t_x + array_width &gt; valid_x2 + 1e-9
    ):
      t_x = valid_x1
    array_height = (h * row) + (y_pitch * (row - 1))
    if center_on_metal_y and self.dvc_type == 'G':
      # GaN ohmic/gate CONT 는 ref 안에서 치우쳐 있는 것이 정상이다.
      # margin 은 샘플에서 측정한 값이므로 margin 기준으로 놓아야 샘플이
      # 그대로 재현된다. (insert_via / insert_pimp / insert_nimp 와 동일)
      t_y = ref.p1.y + margin_b
    elif center_on_metal_y:
      t_y = (center_ref.p2.y + center_ref.p1.y)/2 - array_height/2
    else:
      t_y = (ref.p2.y + ref.p1.y)/2 - array_height/2
    if self.dvc_type == 'M' or self.dvc_type == 'B':
        if row == 2 and col == 2 and not center_on_metal_y:
            t_y = ref.p1.y + margin_b

    if not center_on_metal_y and t_y + h &gt; ref.p2.y:
        t_y = ref.p2.y - h - 0.1
    ttt = pya.CplxTrans((t_x)*1000, (t_y)*1000)
    inst = cell.insert(pya.CellInstArray(self.contCell, ttt, pya.Vector(CoordinateUtils.remove_small_constants(x_pitch+w)*1000, 0), pya.Vector(0, CoordinateUtils.remove_small_constants(y_pitch+h)*1000), col, row))
    inst.set_property(SHAPE_ID_CODE, str(shape_id))

  def insert_pimp(self, shape_id, cell, ref, margin_l, margin_r, margin_t, margin_b, x_pitch, y_pitch, w, tt, center_shape):
    row = self.get_cnt(ref.p2.y - margin_t - (ref.p1.y + margin_b), self.Pimp_h, y_pitch)
    col = self.get_cnt(ref.p2.x - margin_r - (ref.p1.x + margin_l), self.Pimp_w, x_pitch)
    if col &lt; 1 or row &lt; 1:
        logger.warning(
            f"[insert_pimp] shape_id={shape_id} clamped (margin 초과 가능): "
            f"row={row}, col={col} -&gt; 1x1 로 강제. "
            f"ref=({ref.p1.x},{ref.p1.y})-({ref.p2.x},{ref.p2.y}), "
            f"margin=(l={margin_l}, r={margin_r}, t={margin_t}, b={margin_b}), "
            f"pitch=(x={x_pitch}, y={y_pitch}), Pimp=(w={self.Pimp_w}, h={self.Pimp_h})"
        )
    if col &lt; 1:
        col = 1
    if row &lt; 1:
        row = 1
    # x축: 이미 margin-anchored. y축: top_margin≈bottom_margin 이면 가운데정렬(기존),
    # 비대칭이면 sample 위치 보존 위해 margin-anchored 로 전환.
    t_x = ref.p1.x + margin_l
    if abs(margin_t - margin_b) &lt; 1e-9:
      t_y = (ref.p2.y + ref.p1.y)/2 - ((self.Pimp_h * row) + (y_pitch * (row - 1)))/2
    else:
      t_y = ref.p1.y + margin_b
    if self.dvc_type == 'M' or self.dvc_type == 'B':
        if row == 2 and col == 2:
            t_y = ref.p1.y + margin_b

    if t_y + self.Pimp_h &gt; ref.p2.y:
        t_y = ref.p2.y - self.Pimp_h - 0.1
    ttt = pya.CplxTrans((t_x)*1000, (t_y)*1000)
    inst = cell.insert(pya.CellInstArray(self.pimpCell, ttt, pya.Vector(CoordinateUtils.remove_small_constants(x_pitch+self.Pimp_w)*1000, 0), pya.Vector(0, CoordinateUtils.remove_small_constants(y_pitch+self.Pimp_h)*1000), col, row))
    inst.set_property(SHAPE_ID_CODE, str(shape_id))

  def insert_pickup_pimp(self, shape_id, cell, tt):
    if (self.pick_up_hole_x1 is None or self.pick_up_hole_x2 is None or
        self.pick_up_hole_y1 is None or self.pick_up_count is None):
      logger.warning(f"[insert_pickup_pimp] pickup geometry is unavailable: shape_id={shape_id}")
      return None
    row = max(1, int(round(self.pick_up_count)))
    hole_width = self.pick_up_hole_x2 - self.pick_up_hole_x1
    t_x = self.pick_up_hole_x1 + (hole_width - self.Pimp_w) / 2
    t_y = self.pick_up_hole_y1 + (self.hole_size - self.Pimp_h) / 2
    ttt = pya.CplxTrans(t_x * 1000, t_y * 1000)
    inst = cell.insert(pya.CellInstArray(
      self.pimpCell,
      ttt,
      pya.Vector(0, 0),
      pya.Vector(0, CoordinateUtils.remove_small_constants(self.pick_up_pitch) * 1000),
      1,
      row
    ))
    inst.set_property(SHAPE_ID_CODE, str(shape_id))
    return inst

  def insert_nimp(self, shape_id, cell, ref, margin_l, margin_r, margin_t, margin_b, x_pitch, y_pitch, w, tt, center_shape):
    # nimpCell 은 Nimp_w x Nimp_h 로 만들어지므로 세로 계산도 높이를 쓴다
    # (insert_pimp 와 동일).
    h = self.primitive_height('Nimp_h', w)
    row = self.get_cnt(ref.p2.y - margin_t - (ref.p1.y + margin_b), h, y_pitch)
    col = self.get_cnt(ref.p2.x - margin_r - (ref.p1.x + margin_l), w, x_pitch)
    if col &lt; 1 or row &lt; 1:
        logger.warning(
            f"[insert_nimp] shape_id={shape_id} clamped (margin 초과 가능): "
            f"row={row}, col={col} -&gt; 1x1 로 강제. "
            f"ref=({ref.p1.x},{ref.p1.y})-({ref.p2.x},{ref.p2.y}), "
            f"margin=(l={margin_l}, r={margin_r}, t={margin_t}, b={margin_b}), "
            f"pitch=(x={x_pitch}, y={y_pitch}), w={w}"
        )
    if col &lt; 1:
        col = 1
    if row &lt; 1:
        row = 1
    # x축: 이미 margin-anchored. y축: top_margin≈bottom_margin 이면 가운데정렬(기존),
    # 비대칭이면 sample 위치 보존 위해 margin-anchored 로 전환.
    t_x = ref.p1.x + margin_l
    if abs(margin_t - margin_b) &lt; 1e-9:
      t_y = (ref.p2.y + ref.p1.y)/2 - ((h * row) + (y_pitch * (row - 1)))/2
    else:
      t_y = ref.p1.y + margin_b
    if self.dvc_type == 'M' or self.dvc_type == 'B':
        if row == 2 and col == 2:
            t_y = ref.p1.y + margin_b

    if t_y + h &gt; ref.p2.y:
        t_y = ref.p2.y - h - 0.1
    ttt = pya.CplxTrans((t_x)*1000, (t_y)*1000)
    inst = cell.insert(pya.CellInstArray(self.nimpCell, ttt, pya.Vector(CoordinateUtils.remove_small_constants(x_pitch+w)*1000, 0), pya.Vector(0, CoordinateUtils.remove_small_constants(y_pitch+h)*1000), col, row))
    inst.set_property(SHAPE_ID_CODE, str(shape_id))
  
    
class MyLib(pya.Library):
  def __init__(self):
    self.description = "ESD"
    
    # ******************** Resister PCELL Module ********************
    self.layout().register_pcell('3217', Module())
    self.register('3217')

    #self.layout().register_pcell("ESD_Module", Module())
    #self.register("ESD")


MyLib()
</text>
</klayout-macro>
