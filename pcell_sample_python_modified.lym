      Box_PGAN_27 = self.insert_box(27, unitCell, self.l1_layer, [12.85, 581.0 - 0.5*self.M1_34_W], [14.25, 0.5*self.M1_34_W + 581.0], {'depth': 0.237, 'contour': {'version': 1, 'hull': [[0, 0.237, 0, 0.0], [0, 0.224, 0, 0.001], [0, 0.211, 0, 0.003], [0, 0.185, 0, 0.009], [0, 0.173, 0, 0.012], [0, 0.161, 0, 0.017], [0, 0.148, 0, 0.022], [0, 0.137, 0, 0.027], [0, 0.125, 0, 0.034], [0, 0.114, 0, 0.04], [0, 0.103, 0, 0.048], [0, 0.083, 0, 0.064], [0, 0.073, 0, 0.073], [0, 0.064, 0, 0.083], [0, 0.048, 0, 0.103], [0, 0.04, 0, 0.114], [0, 0.034, 0, 0.125], [0, 0.027, 0, 0.137], [0, 0.022, 0, 0.148], [0, 0.017, 0, 0.161], [0, 0.012, 0, 0.173], [0, 0.009, 0, 0.185], [0, 0.003, 0, 0.211], [0, 0.001, 0, 0.224], [0, 0.0, 0, 0.237], [0, 0.0, 1, -0.237], [0, 0.001, 1, -0.224], [0, 0.003, 1, -0.211], [0, 0.009, 1, -0.185], [0, 0.012, 1, -0.173], [0, 0.017, 1, -0.16], [0, 0.027, 1, -0.136], [0, 0.034, 1, -0.125], [0, 0.04, 1, -0.114], [0, 0.048, 1, -0.103], [0, 0.064, 1, -0.083], [0, 0.073, 1, -0.073], [0, 0.083, 1, -0.064], [0, 0.103, 1, -0.048], [0, 0.114, 1, -0.04], [0, 0.125, 1, -0.033], [0, 0.137, 1, -0.027], [0, 0.148, 1, -0.021], [0, 0.161, 1, -0.016], [0, 0.185, 1, -0.008], [0, 0.198, 1, -0.005], [0, 0.224, 1, -0.001], [0, 0.237, 1, 0.0], [1, -0.237, 1, 0.0], [1, -0.224, 1, -0.001], [1, -0.198, 1, -0.005], [1, -0.185, 1, -0.008], [1, -0.173, 1, -0.012], [1, -0.16, 1, -0.016], [1, -0.148, 1, -0.021], [1, -0.136, 1, -0.027], [1, -0.125, 1, -0.033], [1, -0.114, 1, -0.04], [1, -0.103, 1, -0.048], [1, -0.083, 1, -0.064], [1, -0.073, 1, -0.073], [1, -0.064, 1, -0.083], [1, -0.048, 1, -0.103], [1, -0.04, 1, -0.114], [1, -0.033, 1, -0.125], [1, -0.027, 1, -0.136], [1, -0.021, 1, -0.148], [1, -0.016, 1, -0.16], [1, -0.012, 1, -0.173], [1, -0.008, 1, -0.185], [1, -0.005, 1, -0.198], [1, -0.001, 1, -0.224], [1, 0.0, 1, -0.237], [1, 0.0, 0, 0.237], [1, -0.001, 0, 0.224], [1, -0.005, 0, 0.198], [1, -0.008, 0, 0.185], [1, -0.016, 0, 0.161], [1, -0.021, 0, 0.148], [1, -0.027, 0, 0.137], 